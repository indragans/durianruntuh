# ======================================
# Unity .gitignore (Final & Lengkap)
# ======================================

# Folder auto-generated Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# Asset Store Tools
[Aa]ssets/AssetStoreTools*

# Cache & crash reports
sysinfo.txt
*.stacktrace

# Visual Studio / Rider auto files
.vscode/
.idea/
*.sln
*.csproj
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build results
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll

# Addressables cache
/[Aa]ssets/[Aa]ddressableAssetsData/*/Build/**
/[Aa]ssets/[Ss]treamingAssets/aa.meta

# Unity generated meta files (untuk .dll)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Crash log
crashlytics-build.properties

# VS Code debugger
.vs/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
ProjectSettings/ProjectSettings.asset
